# Google Tag Manager Container-ID.
# Bis der echte Container angelegt ist, bleibt der Platzhalter stehen.
# Solange hier "GTM-XXXXXXX" steht, wird kein GTM-Skript geladen (siehe lib/consent.ts).
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Basis-URL der Seite, wird fuer sitemap.xml, robots.txt und Open-Graph-Tags verwendet.
NEXT_PUBLIC_SITE_URL=https://funnelux.ch
